#include <stdio.h>

int findOptimal(int pages[], int frames[], int n, int capacity, int index) {
    int farthest = index, pos = -1;

    for (int i = 0; i < capacity; i++) {
        int j;
        for (j = index; j < n; j++) {
            if (frames[i] == pages[j]) {
                if (j > farthest) {
                    farthest = j;
                    pos = i;
                }
                break;
            }
        }
        if (j == n)
            return i; // Not used again — replace immediately
    }
    return (pos == -1) ? 0 : pos;
}

void optimalPageReplacement(int pages[], int n, int capacity) {
    int frames[capacity], faults = 0, hits = 0;
     int referenceCount = 0;
    for (int i = 0; i < capacity; i++)
        frames[i] = -1;

    for (int i = 0; i < n; i++) {
        int found = 0;
        referenceCount++;
        for (int j = 0; j < capacity; j++) {
            if (frames[j] == pages[i]) {
                hits++;
                printf("Page %d: HIT\n", pages[i]);
                found = 1;
                break;
            }
        }

        if (!found) {
            int pos = -1;
            for (int j = 0; j < capacity; j++) {
                if (frames[j] == -1) {
                    pos = j;
                    printf("Page %d: FAULT, placed in empty frame %d\n", pages[i], pos);
                    break;
                }
            }
            if (pos == -1)
            {
                pos = findOptimal(pages, frames, n, capacity, i + 1);
                printf("Page %d: FAULT, replaced page %d in frame %d\n", pages[i], frames[pos], pos);
            }
            frames[pos] = pages[i];
            faults++;
        }

        printf("Frames: ");
        for (int j = 0; j < capacity; j++)
            frames[j] == -1 ? printf("- ") : printf("%d ", frames[j]);
        printf("\n");
    }
    printf("\nTotal Page References: %d\n", referenceCount);
    printf("Total Page Faults: %d\n", faults);
    printf("Total Page Hits: %d\n", hits);
}

int main() {
    int n, capacity;

    printf("Enter the number of pages ");
    scanf("%d", &n);

    int pages[n];
    printf("Enter the page numbers ");
    for (int i = 0; i < n; i++)
        scanf("%d", &pages[i]);

    printf("Enter the number of frames: ");
    scanf("%d", &capacity);

    optimalPageReplacement(pages, n, capacity);
    return 0;
}
