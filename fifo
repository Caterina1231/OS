#include <stdio.h>

void fifoPageReplacement(int pages[], int n, int capacity) {
    int frames[capacity], front = 0, faults = 0, hits = 0;
     int referenceCount = 0;

    // Initialize frames to empty
    for (int i = 0; i < capacity; i++)
        frames[i] = -1;

    for (int i = 0; i < n; i++) {
        referenceCount++;
        int found = 0;

        // Check if page is already in a frame (page hit)
        for (int j = 0; j < capacity; j++) {
            if (frames[j] == pages[i]) {
                hits++;
                found = 1;
                printf("Page %d: HIT\n", pages[i]);
                break;
            }
        }

        // If not found, replace using FIFO (page fault)
        if (!found) {
            int replaced = frames[front];

            if (replaced == -1) {
                printf("Page %d: FAULT, placed in empty frame %d\n", pages[i], front);
            } else {
                printf("Page %d: FAULT, replaced page %d in frame %d\n", pages[i], replaced, front);
            }

            frames[front] = pages[i];
            front = (front + 1) % capacity;
            faults++;
        }

        // Print current frame state
        printf("Frames: ");
        for (int j = 0; j < capacity; j++)
            frames[j] == -1 ? printf("- ") : printf("%d ", frames[j]);
        printf("\n");

     
    }

    printf("\nTotal Page References: %d\n", referenceCount);
    printf("Total Page Faults: %d\n", faults);
    printf("Total Page Hits: %d\n", hits);
}

int main() {
    int n, capacity;

    printf("Enter the number of pages");
    scanf("%d", &n);

    int pages[n];
    printf("Enter the page numbers: ");
    for (int i = 0; i < n; i++)
        scanf("%d", &pages[i]);

    printf("Enter the number of frames: ");
    scanf("%d", &capacity);

    fifoPageReplacement(pages, n, capacity);
    return 0;
}
